# Server-only. Do not add NEXT_PUBLIC_ to any variable.
APP_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret key (or legacy service_role key), used ONLY for protected quota functions.
SUPABASE_SECRET_KEY=
OWNER_EMAIL=you@example.com
# Authentication > Users > the precreated owner's UUID
OWNER_USER_ID=

OPENAI_API_KEY=
GEMINI_API_KEY=

# Leave off until Supabase sign-in and the SQL migration have been verified.
AI_GENERATION_ENABLED=false
AI_REQUESTS_PER_MINUTE=5
AI_REQUESTS_PER_HOUR=20
AI_REQUESTS_PER_DAY=40
AI_REQUESTS_PER_MONTH=300
AI_MAX_OUTPUT_TOKENS=6000
# Optional comma-separated model IDs:
# AI_ALLOWED_MODELS=gpt-5.2,gpt-4o
